+    dump(EV / 'pruebas_h1_r2_6g1.json',
+         dict(schema='pruebas-h1-r2-6g1/1', filas=todas, detalles=detalle_todo))
+    with (EV / 'matriz_h1_r2_6g1.csv').open('w', newline='',
