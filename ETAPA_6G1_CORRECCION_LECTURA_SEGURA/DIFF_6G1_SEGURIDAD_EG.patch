+            os.replace(tmp, os.path.join(base, nombre))
+        elif modo == 'archivo':
+            tmp = base + '.__cop__'
+            with open(ruta, 'rb') as fsrc, open(tmp, 'wb') as fdst:
+                fdst.write(fsrc.read())
+            os.replace(tmp, os.path.join(base, nombre))
