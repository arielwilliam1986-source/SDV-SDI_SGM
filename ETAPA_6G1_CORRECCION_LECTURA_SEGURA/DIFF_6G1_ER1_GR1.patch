+        w.writeheader()
+        w.writerows(todas)
+    n = {v: sum(1 for f in todas if f['veredicto'] == v)
+         for v in ('PASS', 'FAIL', 'NOT_EXECUTED')}
+    print('RESUMEN: %d PASS, %d FAIL, %d NOT_EXECUTED de %d filas'
