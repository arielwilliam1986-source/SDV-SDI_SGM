+
+    # --- orden temporal
+    orden_ok = (n_inj is not None and n_ab_in is not None and n_ab_out is not None
+                and rutas_abiertas <= set(cerrados_por_ruta)
+                and all(n_inj < cerrados_por_ruta[p]['n'] < n_ab_in for p in rutas_abiertas)
