+        c('sin_descriptores_ni_mapeos_al_abortar',
+          fe['descriptores_salida_o_entradas'] == [] and fe['mapeos_bajo_salida'] == [],
+          '%s %s' % (fe['descriptores_salida_o_entradas'], fe['mapeos_bajo_salida']))
