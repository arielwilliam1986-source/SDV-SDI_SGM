+            w = getattr(r, attr, None)
+            if w is None:
+                continue
+            nombre = getattr(w, 'name', None) or '%s/%s' % (
+                getattr(r, 'cand_id', '?'), attr)
+            ok, err = _cerrar_idempotente_6g1(w)
+            inf['escritores'] += 1
+            paso('escritor_wav', str(nombre), 'close (cabecera finalizada)', ok, err)
