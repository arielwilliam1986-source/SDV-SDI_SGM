+        # 2ª vía: clasificación de propiedad 6G.1 por descriptor
+        cls_fifo = L._clasificar_entrada_6g1(nombre, st_fifo, fd_dir,
+                                             str(base / nombre))
+        st_aside = os.lstat('mix_validado_aside', dir_fd=fd_dir)
