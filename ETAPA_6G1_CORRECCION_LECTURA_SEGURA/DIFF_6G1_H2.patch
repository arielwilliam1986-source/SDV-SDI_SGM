+NOMBRE_MOTOR = {
+    'Hardened': 'MOTOR_SEP_SDV-SDI_v3.1.1_Hardened_Final.py',
+    'EVO': 'MOTOR_SEP_SDV-SDI_EVO.py',
+    'MQR': 'sdv_sdi_mqr_engine.py',
