+# 6C: primitives of the native detector, not of the separation pipeline.
+_ALIGNMENT_RMS_FLOOR = 1e-10
+_ALIGNMENT_MIN_RHO = 0.20
+_ALIGNMENT_MIN_GAP = 0.002
+_MEASURED = ("ALIGNED", "WARNING", "MISALIGNED")
