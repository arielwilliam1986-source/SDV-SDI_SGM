+def _combine(records, clocks=False):
+    """A strong alarm is not erased by another channel's abstention."""
+    states = {r['classification'] for r in records}
+    if 'ERROR' in states:
+        return _decision('ERROR','MEMBER_ERROR')
+    lags = {r['estimated_offset_samples'] for r in records}
+    if records and None not in lags and len(lags) == 1:
+        weakest = min(records, key=lambda r: r['alignment_confidence'])
+        signs = {np.sign(r['correlation_peak']) for r in records if r['correlation_peak'] is not None}
+        return _decision(_severity(weakest['estimated_offset_samples']), 'MEASURED_AGREEMENT',
+                         weakest['estimated_offset_samples'], weakest['correlation_peak'] if len(signs)==1 else None,
+                         weakest['alignment_confidence'])
+    conflict = len(lags-{None}) > 1
+    if clocks and 'MISALIGNED' in states:
+        state = 'MISALIGNED'
+    elif conflict or 'AMBIGUOUS' in states:
+        state = 'AMBIGUOUS'
+    else:
+        state = 'INSUFFICIENT_SIGNAL'
+    return _decision(state, ('L_R_DISAGREE' if clocks else 'WINDOW_DISAGREEMENT') if conflict else 'INCOMPLETE_EVIDENCE')
+
+
+def _alignment_spans(a, b, radius):
+    width = min(15*REQUIRED_SAMPLE_RATE,len(b))
+    end = len(b)-width
+    starts = sorted({*range(0,end+1,15*REQUIRED_SAMPLE_RATE//2), end})
+    scan = [(t,float(b[t:t+width].var()) if width else 0.) for t in starts]
+    chosen = []
+    for t, var in sorted(scan,key=lambda item:-item[1]):
+        if var <= _ALIGNMENT_RMS_FLOOR**2 or any(abs(t-u)<width for u in chosen):
+            continue
+        chosen.append(t)
+        if len(chosen)==2:
+            break
+    spans = [(min(len(a),max(0,t-radius)), min(len(a),t+width+radius),t,t+width) for t in sorted(chosen or [0])]
+    return spans, dict(guide_width=width, starts_and_variances=scan)
