+def _severity(k):
+    if abs(k) <= ALIGNED_TOL_SAMPLES:
+        return 'ALIGNED'
+    if abs(k) <= int(MISALIGNED_TOL_MS*REQUIRED_SAMPLE_RATE/1000):
+        return 'WARNING'
+    return 'MISALIGNED'
