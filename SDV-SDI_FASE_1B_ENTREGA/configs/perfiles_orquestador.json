     }
    ],
    "B_INSTRUMENT": [
     {
      "regex": "^(?P<run>.+?)__backing\\.wav$"
     }
    ],
    "C_AGGREGATE": [
     {
      "regex": "^(?P<run>.+?)__wet\\.wav$"
     }
    ],
    "D_DRY_VOCAL": [
     {
      "regex": "^(?P<run>.+?)__dryvox\\.wav$"
     }
    ],
    "E_VOCALS": [
