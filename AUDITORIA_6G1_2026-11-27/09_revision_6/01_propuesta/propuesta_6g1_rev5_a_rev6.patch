+# ---------------------------------------------------------------------------
+# ANALISIS DE ARGUMENTOS: astype
+#
+# El encargo exige que un metodo solo se readmita "cuando el detector analice
+# los argumentos y demuestre que el resultado es independiente". astype es el
+# caso concreto donde esto se puede intentar:
+#
+#   astype(float)                  -> copy=True por defecto -> COPIA. Se admite.
+#   astype(float, copy=True)       -> COPIA explicita. Se admite.
+#   astype(float, copy=copy_q)     -> `copy` es un valor de EJECUCION. NO se
+#                                     admite: no se puede demostrar.
+#   astype(arr.dtype, copy=False)  -> puede devolver EL MISMO array. NO se admite.
+#   astype(copy=False)             -> idem. NO se admite.
+#   astype(dtype=x, copy=True)     -> copia; el dtype por keyword no molesta.
+#
+# La condicion para admitir es EXACTAMENTE: no aparece `copy` con un valor que
+# no sea el literal True. Es decir, se exige copy=True de forma explicita O la
+# ausencia total de `copy` (que usa el default True).
+#
+# NO se hace distincion por el dtype: da igual el dtype, si copy es True el
+# resultado es un array nuevo con su propio buffer.
+# ---------------------------------------------------------------------------
+def _copy_literal_true(nodo):
+    """True si `nodo` es el literal booleano True (y nada mas)."""
+    return isinstance(nodo, ast.Constant) and nodo.value is True
+
+
+def _astype_es_copia(llamada):
+    """Decide si arr[...].astype(...) devuelve un array INDEPENDIENTE.
+
+    Solo devuelve True cuando se puede DEMOSTRAR estaticamente que copy=True,
+    o bien cuando `copy` no se pasa y se aplica el default documentado (True).
+    Cualquier `copy=` con otro valor, o un valor no literal, devuelve False.
+    """
+    if not isinstance(llamada, ast.Call):
+        return False
+    # posicional 2 = copy (0: dtype, 1: order)
+    if len(llamada.args) >= 3:
+        if not _copy_literal_true(llamada.args[2]):
+            return False
+    for kw in llamada.keywords:
+        if kw.arg == 'copy' and not _copy_literal_true(kw.value):
+            return False
+        if kw.arg is None:            # **kwargs: no se puede demostrar
+            return False
+        if kw.arg in ('out', 'subok', 'casting', 'order'):
+            # `out=` escribe en un array EXTERNO: con ndarray.astype no existe,
+            # pero si apareciera no seria una copia independiente. Se rechaza.
+            return False
+    # Un numero de posicionales inesperado (>3) tampoco se admite.
+    if len(llamada.args) > 3:
+        return False
+    return True
+
 
