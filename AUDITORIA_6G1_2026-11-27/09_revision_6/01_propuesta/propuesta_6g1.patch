+def _ambito(fn, nodo, nombre):
+    """True si el `nombre` de `nodo` se refiere al nombre del AMBITO DE `fn`.
+
+    Un comprehension puede tener un `for arr in ...` que liga su PROPIO arr.
+    Ese arr sombrea al de la funcion y no es el alias del `del mm`.
+
+    Pero un comprehension tambien puede CAPTURAR el alias de la funcion:
+        xs = [arr for _ in z]        <-- aqui `arr` ES el alias externo
+    y eso SI retiene la referencia.
+
+    Regla: se sube por los ancestros. Para cada comprehension encontrado se
+    comprueba si el nodo esta DENTRO de alguno de sus `generators`. Si lo esta,
+    el nombre es local de ese comprehension (sombreado). Si no lo esta (esta en
+    el `elt`, en la `key`/`value` o en el `if` de una comp), es una CAPTURA
+    del alias externo.
+
+    Un lambda o una def anidada que usa el alias tambien lo captura: se
+    considera captura (no sombra), salvo que el alias sea un parametro suyo.
+    """
+    cam = {}
+    for padre in ast.walk(fn):
+        for hijo in ast.iter_child_nodes(padre):
+            cam[hijo] = padre
+
+    act = cam.get(nodo)
+    hijo = nodo
+    while act is not None and act is not fn:
+        if isinstance(act, (ast.ListComp, ast.SetComp, ast.GeneratorExp, ast.DictComp)):
+            # Un comprehension forma su PROPIO ambito. Si alguno de sus
+            # `for ... in ...` liga el nombre, TODO uso del nombre dentro del
+            # comprehension (target, iter, ifs, y el elt/key/value) se refiere
+            # a la variable local, no al alias de la funcion.
+            #
+            # Ojo: si el comprehension NO liga el nombre, entonces un uso
+            # dentro de su elt SI es una captura del alias externo
+            # (xs = [arr for _ in z]), y eso retiene la referencia.
+            liga = any(isinstance(n, ast.Name) and n.id == nombre
+                       for g in act.generators
+                       for n in ast.walk(g.target))
+            if liga:
+                return False
+        elif isinstance(act, (ast.Lambda, ast.FunctionDef, ast.AsyncFunctionDef)):
+            a = act.args
+            params = {x.arg for x in list(a.posonlyargs) + list(a.args) + list(a.kwonlyargs)}
+            if a.vararg:
+                params.add(a.vararg.arg)
+            if a.kwarg:
+                params.add(a.kwarg.arg)
+            if nombre in params:
+                return False
+        hijo = act
+        act = cam.get(act)
+    return True
+
