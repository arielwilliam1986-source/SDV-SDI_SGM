+def _abs_sin_puntos(valor, etiqueta):
+    """Absoluta y sin '..'. Un '..' textual es ambiguo frente a enlaces:
+    abspath lo colapsa en texto y realpath lo resuelve de verdad. Se rechaza."""
+    s = str(valor)
