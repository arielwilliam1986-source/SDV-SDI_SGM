+# ---------------------------------------------------------------------------
+# ANALISIS DE ARGUMENTOS: `out`, `*args` y `**kwargs`
+#
+# La revision 6 admitia los metodos de reduccion por su NOMBRE, dando por hecho
+# que "devuelven un escalar". Eso es cierto SOLO cuando no se pasa `out`. La
+# documentacion de NumPy dice que, si se pasa `out`, el resultado escribe en ese
+# array y el metodo DEVUELVE UNA REFERENCIA a el:
+#
+#     arr[lo:hi].sum(out=arr)
+#
+# escribe la suma dentro del propio memmap y devuelve `arr`. Es un caso
+# patologico, pero precisamente por eso hay que tratarlo: el detector no puede
+# suponer que el codigo es sensato.
+#
+# REGLA (conservadora, la del encargo): CUALQUIER forma de pasar `out` produce
+# NO_CONCLUYENTE, salvo que se demuestre que el objeto de `out` NO PUEDE ser el
+# alias. Y "no ser el alias" no se demuestra comprobando que no se llama "arr":
+# puede haber otro alias (b = arr).
+#
+# Por eso el criterio es DELIBERADAMENTE ASIMETRICO:
+#   - si el objeto de `out` ES el alias (o una vista suya) -> NO_CONCLUYENTE
+#     (no CONCLUYENTE_FALSE: el detector lo demuestra, pero la decision de
+#     adjudicacion del hallazgo F se mantiene en "dudoso" para no declarar
+#     fuga sin ejecucion; ver limitacion L-12);
+#   - si el objeto de `out` NO es el alias -> NO_CONCLUYENTE tambien, porque el
+#     detector NO tiene un analisis de tipos que pruebe que ese otro objeto no
+#     acaba apuntando al memmap por otra via.
+#
+# Es decir: `out=` presente => NO_CONCLUYENTE, sin excepciones. La unica forma
+# de admitir el metodo es que `out` NO aparezca. Esto cumple el punto 3 del
+# encargo sin necesidad de un analisis de tipos que el detector no tiene.
+#
+# SOBRE `*args` / `**kwargs`: si la llamada expande argumentos, no se puede
+# saber si entre ellos va `out`, ni en que posicion. Se rechaza la llamada.
+# ---------------------------------------------------------------------------
+
+# Posicion del parametro `out` en la firma documentada de cada metodo de
+# reduccion de ndarray. Se usa para RECHAZAR el argumento posicional que
+# corresponde a `out`; no para admitir nada.
+#   sum/mean/std/var/prod/min/max : (axis, dtype, out, keepdims, ...)
+#   argmin/argmax                 : (axis, out, ...)   -> out en 2a posicion
+#   any/all                       : (axis, out, keepdims, ...) -> out en 2a
+#
+# OJO: `min`/`max` de ndarray tienen (axis, out, keepdims, initial, where), NO
+# (axis, dtype, out). Su `out` va en la 2a posicion, igual que argmin/argmax.
+# Tenerlo mal aqui solo afectaria a la posicion que se RECHAZA, y como se
+# rechaza por presencia de posicionales de mas, un error aqui no admite nada.
+_POSICION_OUT = {
+    'sum': 2, 'mean': 2, 'std': 2, 'var': 2, 'prod': 2,
+    'min': 1, 'max': 1, 'argmin': 1, 'argmax': 1, 'any': 1, 'all': 1,
+}
+
+
+def _tiene_expansion(llamada):
+    """True si la llamada usa *args o **kwargs: no se puede resolver."""
+    if not isinstance(llamada, ast.Call):
+        return False
+    for a in llamada.args:
+        if isinstance(a, ast.Starred):
+            return True
+    for kw in llamada.keywords:
+        if kw.arg is None:            # **kwargs
+            return True
+    return False
+
+
+def _analizar_args_out(llamada, metodo):
+    """Decide si `vista.metodo(...)` puede retener el memmap por `out`.
+
+    Devuelve (None, None) si NO hay `out` de ninguna forma y no hay expansion.
+    Devuelve ('vista', motivo) en cualquier otro caso.
+
+    No intenta demostrar que un `out` ajeno es seguro: el detector no tiene
+    analisis de tipos y preferir NO_CONCLUYENTE a una suposicion.
+    """
+    if not isinstance(llamada, ast.Call):
+        return ('vista', '%s(): llamada no resuelta' % metodo)
+    # 1) *args / **kwargs: no se puede saber si esconden `out`.
+    if _tiene_expansion(llamada):
+        return ('vista', '%s() con *args/**kwargs: no se puede resolver si '
+                         'llevan out=' % metodo)
+    # 2) `out=` explicito por keyword.
+    for kw in llamada.keywords:
+        if kw.arg == 'out':
+            return ('vista', '%s(out=...) escribe en un array externo y '
+                             'devuelve una referencia a el' % metodo)
+    # 3) `out` pasado por POSICION. Cualquier posicional en o mas alla de la
+    #    posicion de `out` puede serlo (y los posicionales pueden desplazarlo).
+    #    Se rechaza por prudencia: es mas seguro rechazar de mas que de menos.
+    pos_out = _POSICION_OUT.get(metodo)
+    if pos_out is not None and len(llamada.args) > pos_out:
+        return ('vista', '%s(): argumento posicional en la posicion de out '
+                         '(pos %d)' % (metodo, pos_out + 1))
+    return (None, None)
 
 
